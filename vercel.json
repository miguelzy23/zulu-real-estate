{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:archivo(CONTACTOS\\.md|SESSION-SUMMARY\\.md|PROPERTY_MODEL\\.md|apps-script-contactos\\.gs)",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
